# VigorCore — Zoho Catalyst Clean-Slate Architecture POC (.env.example)
# NEVER commit real secrets, tokens, or personal credentials.
# Preflight Check (zero network): npx tsx scripts/verify-clean-slate-provisioning.ts --preflight

# ==============================================================================
# 0. RUNTIME AUTH & CORS MODES (Phase 5.1.1 Zoho Support Reconciliation)
# ==============================================================================
# hosted_native  = Primary mode inside Catalyst Advanced I/O (zcAuth.init; no external OAuth secrets)
# external_oauth = Required for external servers, CLI --live --confirm-readonly, & Gateway fallback
VIGOR_CATALYST_AUTH_MODE=hosted_native
# express_enforced = Express emits Access-Control-* headers
# platform_managed = CloudScale Authorized Domains emits CORS headers; Express omits duplicate Access-Control-*
VIGOR_CORS_MODE=platform_managed

# ==============================================================================
# 1. PUBLIC PROJECT & REGIONAL IDENTIFIERS (Not Secret)
# ==============================================================================
CATALYST_PROJECT_ID=<CATALYST_PROJECT_ID>
# Custom VigorCore deployment selector (Catalyst Console rejects reserved keyword CATALYST_ENVIRONMENT)
VIGORCORE_DEPLOYMENT_ENVIRONMENT=Development
VIGOR_ENVIRONMENT=development
CATALYST_API_DOMAIN=https://api.catalyst.zoho.com
CATALYST_ACCOUNTS_URL=https://accounts.zoho.com
# CATALYST_PROJECT_DOMAIN=<OPTIONAL_PROJECT_DOMAIN>
# CATALYST_FUNCTION_NAME=vigor_api
# CATALYST_RESET_REDIRECT_URL=https://app.vigorcore.lat/auth/login
# X_ZOHO_CATALYST_ORG_ID=<OPTIONAL_CATALYST_ORG_ID>

# Browser Web SDK Public App Identifier (Frontend/Slate ONLY — NOT used by server auth-admin/NoSQL)
# ZAID=<PUBLIC_WEB_SDK_ZAID>

# ==============================================================================
# 2. SERVER-ONLY CREDENTIALS & OAUTH SECRETS (Required ONLY in external_oauth / CLI)
# ==============================================================================
# Optional in hosted_native (Catalyst edge injects x-zc-project-key); required in external_oauth:
# CATALYST_PROJECT_KEY=<CATALYST_PROJECT_KEY>
# CATALYST_PROJECT_SECRET_KEY=<OPTIONAL_PROJECT_SECRET_KEY>

# NOT required inside hosted Catalyst Advanced I/O (Option A); required for CLI --live & fallback (Option B):
# CATALYST_ADMIN_CLIENT_ID=<OAUTH_CLIENT_ID>
# CATALYST_ADMIN_CLIENT_SECRET=<OAUTH_CLIENT_SECRET>
# CATALYST_ADMIN_REFRESH_TOKEN=<OAUTH_REFRESH_TOKEN>
# Alternative ephemeral read-only probe credential (1h TTL; forbidden in prod server runtime):
# CATALYST_ADMIN_ACCESS_TOKEN=<SHORT_LIVED_OAUTH_ACCESS_TOKEN>

# ==============================================================================
# 3. RUNTIME HTTP SECURITY & SESSION HMAC KEYS (Required for Advanced I/O Server)
# ==============================================================================
# Generate CSPRNG 256-bit Base64URL secret (32 random bytes) via Node.js:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
VIGOR_SESSION_HMAC_SECRET=<BASE64URL_32_BYTES_CSPRNG>
VIGOR_SESSION_ACTIVE_KID=k1
VIGOR_SESSION_PREVIOUS_SECRETS_JSON=[]
VIGOR_ALLOWED_ORIGINS=https://app.vigorcore.lat

# Optional local Express runtime listener settings
NODE_ENV=development
PORT=3002
