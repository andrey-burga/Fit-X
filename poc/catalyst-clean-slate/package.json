{
  "name": "vigorcore-catalyst-clean-slate",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "VigorCore Phase 4.0 Clean-Slate Zoho Catalyst Architecture POC (Zero Firestore Data Migration)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.frontend.json",
    "build:server": "tsc -p tsconfig.server.json",
    "frontend:dev": "vite --config vite.frontend.config.ts",
    "frontend:build": "vite build --config vite.frontend.config.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@zcatalyst/auth": "^1.0.0",
    "@zcatalyst/auth-admin": "^1.1.0",
    "@zcatalyst/nosql": "^1.0.0",
    "@zcatalyst/transport": "^1.1.0",
    "@zcatalyst/utils": "^1.1.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.13.0",
    "playwright-core": "^1.65.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
