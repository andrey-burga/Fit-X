{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "../../node_modules/@types"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noEmit": true
  },
  "include": [
    "src/frontend/**/*",
    "frontend/**/*",
    "tests/09-frontend-*",
    "tests/10-frontend-*",
    "tests/11-http-*",
    "tests/22-phase-5.2-*"
  ]
}
